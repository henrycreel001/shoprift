# Telegram Concierge Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTHORIZED_CHAT_ID=

# Google Drive delivery (for ZIPs >49MB)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}  ← paste full JSON as single line
# GOOGLE_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWx  ← folder ID from Drive URL

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key   # needed for Storage uploads in worker

# Redis (BullMQ queue — Railway Redis plugin URL)
REDIS_URL=redis://localhost:6379

# Razorpay (web app payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Output
OUTPUT_DIR=./output

# Browser
HEADLESS=true

# App
SHOPRIFT_VERSION=1.0.0
VERIFICATION_EXPIRY_MINUTES=10
